<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Normal permission for the optional app lock's BiometricPrompt (ADR-023); no runtime request. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".DailyRecordApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyRecord"
        android:usesCleartextTraffic="false">
        <!-- Local-first: Firebase is initialized lazily by FirebaseServices only
            on the signed-in path. Removing the auto-init provider keeps cold
            start in offline/local mode free of Firebase initialization. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <!-- The only activity. It has no launcher entry of its own: the two
            aliases below are the home screen identities (ADR-024), and only
            they are ever enabled or disabled. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyRecord"
            android:windowSoftInputMode="adjustResize" />
        <!-- Default identity. It keeps the component name of earlier
            releases, so icons pinned to the home screen survive the update. -->
        <activity-alias
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Optional neutral "Journal" identity, off until the user turns the
            disguise on in settings. -->
        <activity-alias
            android:name=".JournalLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_journal"
            android:label="@string/app_name_journal"
            android:roundIcon="@mipmap/ic_launcher_journal_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
