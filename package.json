{
  "name": "daily-record-firebase-tests",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test:docs": "node --test scripts/docs-integrity.test.mjs scripts/documentation-catalog.test.mjs",
    "test:copy": "node --test scripts/copy-integrity.test.mjs",
    "test:release-metadata": "node --test scripts/release-metadata.test.mjs",
    "test:android-connected": "firebase emulators:exec --project demo-daily-record-app --only auth,firestore,functions \"gradlew.bat connectedDebugAndroidTest --no-parallel\"",
    "test:android-connected:windows": "firebase emulators:exec --project demo-daily-record-app --only auth,firestore,functions \"gradlew.bat connectedDebugAndroidTest --no-parallel\"",
    "test:android-connected:unix": "firebase emulators:exec --project demo-daily-record-app --only auth,firestore,functions \"./gradlew connectedDebugAndroidTest --no-parallel\"",
    "test:firestore-rules": "firebase emulators:exec --project demo-daily-record-app --only firestore,functions \"node scripts/firestore-rules.test.mjs\"",
    "test:functions": "firebase emulators:exec --project demo-daily-record-app --only firestore,functions \"node scripts/firestore-rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0"
  }
}
