# Gradle files
.gradle/
.kotlin/
build/
node_modules/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Local configuration file (sdk path, etc)
local.properties

# Local environment and secret configuration
.env
.env.*
!.env.example
secrets.properties
keystore.properties

# Log/OS Files
*.log
.DS_Store
Thumbs.db
Desktop.ini

# Local scratch area for audit runs, screenshots, uiautomator dumps and task
# worktrees. Task scratch must never be committed, so it is excluded by name.
work/
scratch/
*.tmp
*.bak
*.back

# Test and report output written outside build/
reports/
test-results/

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore and private key files
*.jks
*.keystore
*.p12
*.pfx
*.pem

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof
